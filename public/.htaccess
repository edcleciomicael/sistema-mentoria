<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permitir arquivos e pastas existentes diretamente sem reescrita
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Se for requisição SPA, manda para index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Liberar CORS para fontes e scripts estáticos da própria aplicação
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
  Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
</IfModule>

# Compressão Gzip para Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
